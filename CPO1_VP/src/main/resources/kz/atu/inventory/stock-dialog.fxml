<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="kz.atu.inventory.StockDialogController" prefWidth="400">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label fx:id="headerLabel" styleClass="form-title" text="Операция"/>
    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="120"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Товар:" GridPane.rowIndex="0"/>
        <Label fx:id="productLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Сейчас на складе:" GridPane.rowIndex="1"/>
        <Label fx:id="currentLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Количество *" GridPane.rowIndex="2"/>
        <TextField fx:id="amountField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Комментарий" GridPane.rowIndex="3"/>
        <TextField fx:id="commentField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="applyButton" text="Применить" styleClass="btn-success" defaultButton="true" onAction="#onApply"/>
        <Button text="Отмена" styleClass="btn-neutral" cancelButton="true" onAction="#onCancel"/>
    </HBox>
</VBox>