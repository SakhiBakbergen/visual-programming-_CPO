<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="kz.atu.inventory.ProductFormController" prefWidth="420">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label fx:id="titleLabel" styleClass="form-title" text="Товар"/>
    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="140"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Название *" GridPane.rowIndex="0"/>
        <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Категория *" GridPane.rowIndex="1"/>
        <ComboBox fx:id="categoryBox" editable="true" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Цена, ₸ *" GridPane.rowIndex="2"/>
        <TextField fx:id="priceField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Остаток *" GridPane.rowIndex="3"/>
        <TextField fx:id="qtyField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Мин. остаток *" GridPane.rowIndex="4"/>
        <TextField fx:id="minField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label text="Поставщик" GridPane.rowIndex="5"/>
        <TextField fx:id="supplierField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Сохранить" styleClass="btn-primary" defaultButton="true" onAction="#onSave"/>
        <Button text="Отмена" styleClass="btn-neutral" cancelButton="true" onAction="#onCancel"/>
    </HBox>
</VBox>